<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    
    <!-- NuGet Package Metadata -->
    <PackageId>EmailerUtility</PackageId>
    <Version>1.0.0</Version>
    <Authors>Alan Nevill</Authors>
    <Company>Alan Nevill</Company>
    <Product>EmailerUtility</Product>
    <Description>Email utility library for managing email messages and recipients using Entity Framework Core</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/AlanNevill/InternetSpeedTest</RepositoryUrl>
    <PackageTags>email;utility;entityframework</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.2" />
  </ItemGroup>
</Project>
